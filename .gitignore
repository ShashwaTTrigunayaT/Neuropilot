# ---- Datasets ----
data/raw/*
data/processed/*
!data/raw/README.md
!data/processed/risk_scores.json
!data/processed/.gitkeep

# ---- Restricted datasets (ADNI / OASIS Data Use Agreements) ----
# Never commit these: ADNI is access-controlled under a DUA, not redistributable.
ADNI DATA/
ADNI_DATA/
adni*/
!scripts/generate_adni_like*.py
*.csv
!artifacts/*.csv
!data/raw/README.md

# ---- ML artifacts for deployment ----
artifacts/*
!artifacts/pipeline.joblib
!artifacts/model_meta.json
!artifacts/global_importance.csv
!artifacts/eval_report.txt
!artifacts/model_audit.txt
!artifacts/progression_delta.joblib
!artifacts/progression_conversion.joblib
!artifacts/progression_meta.json
!artifacts/progression_report.txt

