# Alzheimer's Prioritization System — environment configuration
# Copy to .env (or set in your shell / docker-compose) and adjust as needed.

# ---- Risk tier thresholds (config.py) ----
# A score > HIGH -> high tier; >= MEDIUM -> medium; else low.
HIGH_RISK_THRESHOLD=0.7
MEDIUM_RISK_THRESHOLD=0.4

# ---- Artifact paths (defaults shown; override for custom layouts / Docker) ----
PROJECT_ROOT=
RISK_SCORES_PATH=data/processed/risk_scores.json
GLOBAL_IMPORTANCE_PATH=artifacts/global_importance.csv
MODEL_PATH=artifacts/pipeline.joblib
MODEL_META_PATH=artifacts/model_meta.json

# ---- Data source ----
# real    -> serve the 150-subject OASIS-1 cohort (requires the CSV in data/raw/)
# synthetic (default) -> prefer the generated ADNI-shaped cohort
OASIS_DATA_MODE=synthetic

# ---- Optional PostgreSQL persistence (backend/app/db.py) ----
# When set, patients/pipeline history persist across restarts.
# Example: postgresql+psycopg://postgres:postgres@db:5432/prioritization
DATABASE_URL=

# ---- Frontend (Vite) ----
# Base URL of the API as seen from the browser (nginx proxies /api in Docker).
VITE_API_URL=http://127.0.0.1:8000

# ---- Backend CORS (main.py) ----
# Comma-separated extra origins allowed to call the API (Vite dev server is
# always allowed). Example: CORS_ORIGINS=http://localhost:4173,https://demo.example.com
CORS_ORIGINS=

# ---- FHIR interoperability (backend/app/fhir_client.py, smart.py) ----
# Outbound hospital FHIR server. Empty = not configured, and every outbound call
# says so plainly instead of pretending a hospital is connected.
# Local reference server: docker run -d --name neuropilot-hapi -p 8090:8080 hapiproject/hapi:latest
FHIR_BASE_URL=
# Push each newly placed order as a ServiceRequest. Off by default: the triage
# loop must never block on a network call.
FHIR_PUSH_ORDERS=false
# Static bearer token, for a server that does not use SMART (a HAPI test server
# usually runs open; a real one never does — use SMART below).
FHIR_AUTH_TOKEN=
FHIR_TIMEOUT_SECONDS=8

# ---- SMART on FHIR (OAuth 2.0 authorization-code + PKCE) ----
# Client id issued by the EHR sandbox (Epic App Orchard / Cerner code console)
# when NeuroPilot is registered as a SMART app. A public client has no secret —
# PKCE is what protects it. An unregistered client id is rejected by the EHR.
SMART_CLIENT_ID=neuropilot-demo
SMART_CLIENT_SECRET=
# Must match the registered redirect URI byte-for-byte.
SMART_REDIRECT_URI=http://localhost:8000/fhir/smart/callback
# Where the browser lands after the backend has exchanged the code.
FRONTEND_BASE_URL=http://localhost:5173
# Minimum-necessary scope set; widen only with a clinical justification.
SMART_SCOPES=launch/patient openid fhirUser patient/Patient.read patient/Observation.read patient/DiagnosticReport.read patient/RiskAssessment.read patient/RiskAssessment.write

# ---- ABDM (India) — HIU consent flow + Fidelius encryption ----
# See ABDM_INTEGRATION.md. With nothing set here, the in-process mock Consent
# Manager + mock HIP run at /mock-abdm, so the consent -> grant -> encrypted pull
# -> re-score loop works out of the box with no ABDM account.

# A real Consent Manager (e.g. https://dev.abdm.gov.in/cm). Empty = use the mock.
ABDM_CM_BASE_URL=
ABDM_CM_ID=sbx
ABDM_HIU_ID=neuropilot-demo-hiu
# A real HIU signs each request with its ABDM key pair; the mock accepts a static
# bearer (limitation L11).
ABDM_CM_TOKEN=mock-cm-token
ABDM_REQUESTER_NAME=NeuroPilot Memory Clinic
ABDM_REQUESTER_REGNO=NEUROPILOT-0001
# Where the Consent Manager calls us back, and where the HIP pushes records.
# MUST be publicly reachable for a real sandbox (127.0.0.1 works only locally).
ABDM_CALLBACK_BASE_URL=http://127.0.0.1:8000
ABDM_TIMEOUT_SECONDS=10
# Run the mock HIE-CM + mock HIP. Ignored when ABDM_CM_BASE_URL is set.
ABDM_USE_MOCK_GATEWAY=true
