# Alzheimer's Prioritization System — environment configuration
# Copy to .env (or set in your shell / docker-compose) and adjust as needed.

# ---- Risk tier thresholds (config.py) ----
# A score > HIGH -> high tier; >= MEDIUM -> medium; else low.
HIGH_RISK_THRESHOLD=0.7
MEDIUM_RISK_THRESHOLD=0.4

# ---- Artifact paths (defaults shown; override for custom layouts / Docker) ----
PROJECT_ROOT=
RISK_SCORES_PATH=data/processed/risk_scores.json
GLOBAL_IMPORTANCE_PATH=artifacts/global_importance.csv
MODEL_PATH=artifacts/pipeline.joblib
MODEL_META_PATH=artifacts/model_meta.json

# ---- Data source ----
# real    -> serve the 150-subject OASIS-1 cohort (requires the CSV in data/raw/)
# synthetic (default) -> prefer the generated ADNI-shaped cohort
OASIS_DATA_MODE=synthetic

# ---- Optional PostgreSQL persistence (backend/app/db.py) ----
# When set, patients/pipeline history persist across restarts.
# Example: postgresql+psycopg://postgres:postgres@db:5432/prioritization
DATABASE_URL=

# ---- Frontend (Vite) ----
# Base URL of the API as seen from the browser (nginx proxies /api in Docker).
VITE_API_URL=http://127.0.0.1:8000

# ---- Backend CORS (main.py) ----
# Comma-separated extra origins allowed to call the API (Vite dev server is
# always allowed). Example: CORS_ORIGINS=http://localhost:4173,https://demo.example.com
CORS_ORIGINS=
